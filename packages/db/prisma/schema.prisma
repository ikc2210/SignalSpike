generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QueryTemplate {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  templateType    String   // entity_type_discovery | entity_monitoring
  entityTypes     String[]
  targetEntityIds String[]
  objective       String   // positions | priorities | activities
  topics          String[]
  queryPattern    String
  cadence         String   // daily | weekly | monthly | ad_hoc
  domainAllowlist String[]
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs     MonitoringRun[]
  schedule Schedule?
}

model Entity {
  id            String   @id @default(cuid())
  name          String
  entityType    String
  defaultLayer  String
  jurisdictions String[]
  sectors       String[]
  active        Boolean  @default(true)
  approvalState String   @default("proposed")
  subtype       String?
  description   String?
  discoveredBy  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases  EntityAlias[]
  runs     MonitoringRun[]
  findings RunFinding[]
  signals  Signal[]
}

model EntityAlias {
  id       String @id @default(cuid())
  entityId String
  alias    String

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, alias])
  @@index([entityId])
}

model MonitoringRun {
  id            String    @id @default(cuid())
  templateId    String
  entityId      String?
  status        String    @default("queued")
  queryExpanded String
  rawResponse   Json?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  template QueryTemplate @relation(fields: [templateId], references: [id])
  entity   Entity?       @relation(fields: [entityId], references: [id])
  sources  RunSource[]
  findings RunFinding[]
  signals  Signal[]
}

model RunSource {
  id      String   @id @default(cuid())
  runId   String
  url     String
  title   String?
  snippet String?
  domain  String?
  citedAt DateTime @default(now())

  run MonitoringRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model RunFinding {
  id         String   @id @default(cuid())
  runId      String
  entityId   String?
  summary    String
  signalType String?
  topics     String[]
  createdAt  DateTime @default(now())

  run     MonitoringRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  entity  Entity?       @relation(fields: [entityId], references: [id])
  signals Signal[]

  @@index([runId])
  @@index([entityId])
}

model Signal {
  id               String   @id @default(cuid())
  runId            String
  runFindingId     String
  entityId         String
  entityType       String
  queryTemplateId  String
  templateType     String
  objective        String   // activities | positions | priorities
  signalType       String?
  title            String
  summary          String
  sourceUrls       String[]
  sourceDomains    String[]
  topicTags        String[]
  jurisdictionTags String[]
  observedAt       DateTime
  extractedAt      DateTime @default(now())
  importance       Int
  confidence       Int

  // ActivitySignal fields
  changeType      String?
  eventDate       DateTime?
  actorsMentioned String[]

  // PositionSignal fields
  topic            String?
  positionLabel    String?
  stance           String?
  strength         Int?
  evidenceSnippets String[]

  // PrioritySignal fields
  priorityLabel       String?
  priorityDirection   String?
  momentum            Int?
  rationale           String?
  supportingSignalIds String[]

  // EntityType-specific details (JSON)
  details Json?

  run        MonitoringRun @relation(fields: [runId], references: [id])
  runFinding RunFinding    @relation(fields: [runFindingId], references: [id], onDelete: Cascade)
  entity     Entity        @relation(fields: [entityId], references: [id])

  @@index([runId])
  @@index([runFindingId])
  @@index([entityId])
  @@index([objective])
  @@index([observedAt])
}

model Schedule {
  id         String    @id @default(cuid())
  templateId String    @unique
  cadence    String
  nextRunAt  DateTime
  lastRunAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  template QueryTemplate @relation(fields: [templateId], references: [id])
}
